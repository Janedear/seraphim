<Window x:Class="Seraphim.App.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Seraphim"
        Height="420" Width="560"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#FF05070A">
    <Grid>
        <Image Source="pack://application:,,,/Assets/seraphim-hud-blue.png"
               Stretch="UniformToFill"
               Opacity="0.28"
               IsHitTestVisible="False" />
        <Border Width="440" Padding="28" CornerRadius="12"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#E605070A" BorderBrush="#8822D3EE" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="SERAPHIM" FontWeight="Bold" FontSize="16" Foreground="#FFE2E8F0"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="Headline" FontSize="20" FontWeight="SemiBold" Foreground="#FFF8FAFC"
                           HorizontalAlignment="Center" Margin="0,14,0,10" />
                <TextBlock x:Name="Terms" FontSize="13" Foreground="#FF94A3B8" TextWrapping="Wrap"
                           TextAlignment="Left" Margin="0,0,0,16" />
                <CheckBox x:Name="AgreeBox" Foreground="#FFE2E8F0" Margin="0,0,0,16"
                          Checked="OnAgree" Unchecked="OnAgree" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="DeclineBtn" Padding="16,8" Margin="0,0,12,0" Click="OnDecline" />
                    <Button x:Name="ContinueBtn" Padding="16,8" Click="OnContinue" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
