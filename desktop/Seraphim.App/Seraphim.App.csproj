<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>Seraphim.App</RootNamespace>
    <ApplicationTitle>Seraphim</ApplicationTitle>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.0</Version>
    <FileVersion>0.1.0.0</FileVersion>
    <Product>Seraphim</Product>
    <Description>Native Windows pentest workbench</Description>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Seraphim.Engine\Seraphim.Engine.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\seraphim-hud-blue.png" />
    <Resource Include="Assets\seraphim-hud-red.png" />
    <Content Include="Setup-Seraphim.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Install-Seraphim.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
