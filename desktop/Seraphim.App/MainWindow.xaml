<Window x:Class="Seraphim.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Seraphim — Blue"
        Height="800" Width="1280"
        Background="#FF05070A"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Image x:Name="HudBlue"
               Source="pack://application:,,,/Assets/seraphim-hud-blue.png"
               Stretch="UniformToFill"
               Opacity="0.55"
               IsHitTestVisible="False"
               RenderOptions.BitmapScalingMode="HighQuality" />
        <Image x:Name="HudRed"
               Source="pack://application:,,,/Assets/seraphim-hud-red.png"
               Stretch="UniformToFill"
               Opacity="0"
               IsHitTestVisible="False"
               RenderOptions.BitmapScalingMode="HighQuality" />
        <Rectangle x:Name="HudRedWash"
                   IsHitTestVisible="False"
                   Opacity="0"
                   Fill="#40FF1A12" />
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.85" RadiusY="0.85">
                    <GradientStop Color="#00000000" Offset="0.18" />
                    <GradientStop Color="#47000000" Offset="0.58" />
                    <GradientStop Color="#B3000000" Offset="1.0" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
                <RowDefinition Height="88" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="240" />
            </Grid.ColumnDefinitions>

            <Border x:Name="CaptionBar" Grid.ColumnSpan="3" BorderBrush="#5522D3EE" BorderThickness="0,0,0,1" Background="#9905070A">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="SERAPHIM" FontWeight="Bold" FontSize="14" Foreground="#FFE2E8F0" />
                        <TextBlock x:Name="CatalogChip" Text="" Foreground="#FF94A3B8" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0" />
                        <TextBlock Text="  Allowed networks" Foreground="#FF94A3B8" FontSize="12" VerticalAlignment="Center" Margin="12,0,8,0" />
                        <TextBox x:Name="ScopeBox" Width="280" Padding="6,2" VerticalAlignment="Center" LostFocus="OnScopeCommit" KeyDown="OnScopeKey"
                                 ToolTip="Networks you're allowed to test. Home Wi-Fi is usually 192.168.0.0/16. Public internet stays blocked." />
                        <TextBlock x:Name="AiChip" Text="  AI: checking…" Foreground="#FF94A3B8" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BlueBtn" Content="BLUE" Click="OnBlue" Padding="14,6" Margin="0,0,8,0" />
                        <Button x:Name="RedBtn" Content="RED" Click="OnRed" Padding="14,6" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="CategoryStrip" Grid.Row="1" BorderBrush="#3322D3EE" BorderThickness="0,0,1,0" Background="#6605070A">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="220" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="WorkLabel" Text="BLUE WORK" Foreground="#FF64748B" FontSize="11" Margin="0,0,0,6" />
                    <ListBox x:Name="Categories" Grid.Row="1" SelectionChanged="OnCategory" />
                    <TextBlock x:Name="ToolCountLabel" Grid.Row="2" Text="TOOLS" Foreground="#FF64748B" FontSize="11" Margin="0,10,0,6" />
                    <TextBox x:Name="ToolSearch"
                             Grid.Row="3"
                             Margin="0,0,0,8"
                             ToolTip="Filter by name, id, executable, or summary"
                             TextChanged="OnToolSearch" />
                    <ListBox x:Name="ToolsList" Grid.Row="4" SelectionChanged="OnTool">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="Bold"
                                               Foreground="#FFE2E8F0"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Summary}"
                                               Foreground="#FF64748B"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               MaxHeight="32" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Grid.Column="1" Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border x:Name="FormGlass" CornerRadius="8" BorderThickness="1" BorderBrush="#8822D3EE" Background="#66000000" Padding="16" Margin="0,0,0,12">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock x:Name="ToolTitle" Text="Nmap" FontSize="18" FontWeight="SemiBold" Foreground="#FFF8FAFC" />
                            <TextBlock x:Name="ToolSummary" Text="" Foreground="#FF94A3B8" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,8" />
                            <TextBlock x:Name="PlainPreview" FontSize="13" Foreground="#FFE2E8F0" TextWrapping="Wrap" Margin="0,0,0,4" />
                            <TextBlock x:Name="CommandPreview" FontFamily="Consolas" FontSize="11" Foreground="#FF64748B" TextWrapping="Wrap" Margin="0,0,0,10" />
                            <ComboBox x:Name="PresetBox" SelectionChanged="OnPreset" Margin="0,0,0,10" Visibility="Collapsed" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="RunBtn" Content="Run" Click="OnRun" Padding="20,8" Margin="0,0,8,0" />
                            <Button Content="Save finding" Click="OnSaveFinding" Padding="16,8" Margin="0,0,8,0" />
                            <Button Content="Draft report" Click="OnDraftReport" Padding="16,8" />
                        </StackPanel>
                        <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="FormHost" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>
                <Border Grid.Row="1" CornerRadius="8" BorderThickness="1" BorderBrush="#FF1E293B" Background="#B3000000" Padding="12">
                    <ScrollViewer x:Name="SessionScroll">
                        <TextBlock x:Name="SessionOut" FontFamily="Consolas" FontSize="13" Foreground="#FFCBD5E1" TextWrapping="Wrap"
                                   Text="Pick a type of work on the left, then a tool. Fill in the form in plain language and click Run. If the program isn't installed, we'll say so — we never fake a result." />
                    </ScrollViewer>
                </Border>
            </Grid>

            <Border Grid.Row="1" Grid.Column="2" BorderBrush="#1AFFFFFF" BorderThickness="1,0,0,0" Background="#6605070A" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="SAVED NOTES" Foreground="#FF64748B" FontSize="11" Margin="0,0,0,8" />
                    <ListBox x:Name="FindingsList" DisplayMemberPath="Title" />
                </DockPanel>
            </Border>

            <Border x:Name="ComposerBar" Grid.Row="2" Grid.ColumnSpan="3" BorderBrush="#5522D3EE" BorderThickness="0,1,0,0" Background="#9905070A" Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="AgentPick" DisplayMemberPath="Name" Width="110" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <ComboBox x:Name="ModelPick" Grid.Column="1" Width="88" Margin="0,0,8,0" VerticalAlignment="Center" SelectionChanged="OnModelPick">
                        <ComboBoxItem Content="Inside" IsSelected="True" />
                        <ComboBoxItem Content="BYO" />
                    </ComboBox>
                    <Grid Grid.Column="2">
                        <TextBox x:Name="PromptBox" KeyDown="OnPromptKey" TextChanged="OnPromptText" />
                        <TextBlock x:Name="PromptHint"
                                   Text="Ask Inside — stays on this PC"
                                   Foreground="#FF64748B"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"
                                   IsHitTestVisible="False" />
                    </Grid>
                    <TextBox x:Name="ByoEndpoint" Grid.Column="3" Width="160" Margin="8,0,0,0" VerticalAlignment="Center"
                             Visibility="Collapsed" ToolTip="Vendor endpoint (leaves this PC)" />
                    <PasswordBox x:Name="ByoKey" Grid.Column="4" Width="120" Margin="8,0,0,0" VerticalAlignment="Center"
                                 Visibility="Collapsed" ToolTip="Vendor API key" />
                    <CheckBox x:Name="AttachSession" Grid.Column="5" Content="Attach session" Foreground="#FF94A3B8" VerticalAlignment="Center" Margin="12,0" />
                    <CheckBox x:Name="AutoRunBox" Grid.Column="6" Content="Auto-run in-scope" Foreground="#FF94A3B8" VerticalAlignment="Center" Margin="8,0" IsChecked="True" />
                    <Button x:Name="SendBtn" Grid.Column="7" Content="Send Inside" Click="OnSend" Padding="16,8" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
