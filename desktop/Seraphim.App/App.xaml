<Application x:Class="Seraphim.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             >
    <Application.Resources>
        <SolidColorBrush x:Key="TeamPick" Color="#5522D3EE" />
        <SolidColorBrush x:Key="TeamHover" Color="#3322D3EE" />
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#FFE2E8F0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Foreground" Value="#FFE2E8F0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TeamHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TeamPick}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#CC0B1220" />
            <Setter Property="Foreground" Value="#FFF8FAFC" />
            <Setter Property="BorderBrush" Value="#FF334155" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="CaretBrush" Value="#FFE2E8F0" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFE2E8F0" />
            <Setter Property="Margin" Value="0,4,0,8" />
        </Style>
    </Application.Resources>
</Application>
