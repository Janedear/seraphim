# Copy to .env.local

# Hosted backend (leave unset when using the local lab)
# VITE_BASE44_APP_ID=
# VITE_BASE44_APP_BASE_URL=
# VITE_BASE44_FUNCTIONS_VERSION=

# Local lab
VITE_PREVIEW_MODE=true
VITE_LOCAL_BACKEND=true

# LLM (optional — reports, text analysis, vuln commentary)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Function secrets (also set these in hosted function config)
# VIRUSTOTAL_API_KEY=
# ABUSEIPDB_API_KEY=
# ATTACK_SIMULATION_API_URL=
# ATTACK_SIMULATION_API_KEY=
# DISASSEMBLY_API_URL=
# BREACH_VIP_API_KEY=
# HACKERTARGET_BASE=https://api.hackertarget.com
# NMAP_API_URL=
